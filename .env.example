# ─── Database ────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=unmapped
POSTGRES_PASSWORD=unmapped_dev
POSTGRES_DB=unmapped

DATABASE_URL=postgresql+asyncpg://unmapped:unmapped_dev@localhost:5432/unmapped

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant ──────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ─── Google / Gemini ─────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL_PRO=gemini-1.5-pro
GEMINI_MODEL_FLASH=gemini-1.5-flash

# ─── LangSmith (optional) ───────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=unmapped

# ─── Prefect ─────────────────────────────────────────────
PREFECT_API_URL=http://localhost:4200/api

# ─── Auth / JWT ──────────────────────────────────────────
JWT_SECRET_KEY=CHANGE-ME-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ANONYMOUS_TOKEN_EXPIRE_HOURS=24
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Application ─────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=DEBUG
CONFIG_DIR=configs/countries
CONFIG_REDIS_TTL_SECONDS=300
